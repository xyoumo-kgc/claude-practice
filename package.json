{
  "name": "web-cad",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:single": "tsc && vite build --config vite.single.config.ts",
    "preview": "vite preview",
    "typecheck": "tsc && tsc -p tests/tsconfig.json",
    "test": "npm run test:skills && npm run test:e2e",
    "test:e2e": "playwright test",
    "test:skills": "python3 tests/skills/check_proposal.py"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "pdfjs-dist": "^4.10.38",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^26.1.2",
    "@types/three": "^0.170.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vite-plugin-singlefile": "^2.3.3"
  }
}
